{
  "manifest_version": 3,
  "name": "Rain Browser",
  "version": "0.0.6",
  "description": "Import web-hosted logs and diagnostic files directly into Rain.",
  "key": "",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Rain Browser",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/rain-browser-16.png",
      "32": "icons/rain-browser-32.png",
      "48": "icons/rain-browser-48.png",
      "128": "icons/rain-browser-128.png"
    }
  },
  "icons": {
    "16": "icons/rain-browser-16.png",
    "32": "icons/rain-browser-32.png",
    "48": "icons/rain-browser-48.png",
    "128": "icons/rain-browser-128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
